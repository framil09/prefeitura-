generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SECRETARIO
  EDITOR
}

enum SecaoAdmin {
  DASHBOARD
  GESTAO_MUNICIPAL
  SECRETARIAS
  TURISMO
  TRANSPARENCIA
  LICITACOES
  EDITAIS_CHAMADAS
  EMENDAS_IMPOSITIVAS
  NOTICIAS
  GALERIA
  USUARIOS
  CONFIGURACAO
}

enum StatusLicitacao {
  ABERTA
  EM_ANDAMENTO
  ENCERRADA
  SUSPENSA
  CANCELADA
}

enum TipoMidia {
  FOTO
  VIDEO
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String
  role          UserRole   @default(EDITOR)
  secretariaId  String?
  secretaria    Secretaria? @relation(fields: [secretariaId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  noticias      Noticia[]
  permissoes    Permissao[]
}

model Permissao {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  secao         SecaoAdmin
  permitido      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, secao])
  @@index([userId])
}

model Secretaria {
  id          String    @id @default(cuid())
  nome        String
  sigla       String?
  descricao   String?   @db.Text
  secretario  String?
  fotoSecretario String?
  telefone    String?
  email       String?
  endereco    String?
  ordem       Int       @default(0)
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  noticias    Noticia[]
  licitacoes  Licitacao[]
}

model Licitacao {
  id                   String          @id @default(cuid())
  numero               String
  modalidade           String
  objeto               String          @db.Text
  descricaoDetalhada   String?         @db.Text
  valorEstimado        Decimal?        @db.Decimal(15, 2)
  dataAbertura         DateTime
  dataEncerramento     DateTime?
  status               StatusLicitacao @default(ABERTA)
  editalUrl            String?
  contactoPessoa       String?
  contactoEmail        String?
  contactoTelefone     String?
  local                String?
  secretariaId         String?
  secretaria           Secretaria?     @relation(fields: [secretariaId], references: [id])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Noticia {
  id            String      @id @default(cuid())
  titulo        String
  resumo        String?     @db.Text
  conteudo      String      @db.Text
  imagemCapa    String?
  videoUrl      String?
  fotos         String[]    @default([])
  destaque      Boolean     @default(false)
  publicado     Boolean     @default(true)
  dataInicio    DateTime?
  dataFim       DateTime?
  autorId       String?
  autor         User?       @relation(fields: [autorId], references: [id])
  secretariaId  String?
  secretaria    Secretaria? @relation(fields: [secretariaId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([publicado])
  @@index([destaque])
}

model Midia {
  id          String    @id @default(cuid())
  titulo      String
  descricao   String?
  tipo        TipoMidia
  url         String
  thumbnail   String?
  destaque    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ConfiguracaoSite {
  id              String   @id @default(cuid())
  nomeCidade      String   @default("Lambari")
  slogan          String?  @default("Estância Hidromineral")
  fotoSlogan      String?
  logoUrl         String?
  bannerUrl       String?
  telefone        String?
  email           String?
  endereco        String?
  horarioAtendimento String?
  facebookUrl     String?
  instagramUrl    String?
  youtubeUrl      String?
  prefeito        String?
  fotoPrefeito    String?
  vicePrefeito    String?
  fotoVicePrefeito String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model Prefeito {
  id            String    @id @default(cuid())
  nome          String
  foto          String?
  ano_inicio    Int
  ano_fim       Int?
  descricao     String?   @db.Text
  partido       String?
  destaque      Boolean   @default(false)
  ativo         Boolean   @default(true)
  ordem         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ano_inicio])
  @@index([destaque])
}

model EmendaImpositiva {
  id            String    @id @default(cuid())
  numero        String    @unique
  titulo        String
  descricao     String?   @db.Text
  autor         String?
  secretaria    String?
  valor         Decimal?  @db.Decimal(15, 2)
  dataAutoria   DateTime?
  dataExecucao  DateTime?
  percentualExecucao Int?   @default(0)
  documentoUrl  String?
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([numero])
  @@index([ativo])
}

model EditalChamadaPublica {
  id              String    @id @default(cuid())
  numero          String    @unique
  titulo          String
  descricao       String?   @db.Text
  tipo            String    // ex: "Edital", "Chamada Pública", "Licitação"
  dataAbertura    DateTime?
  dataEncerramento DateTime?
  documentoUrl    String?
  resultadoUrl    String?
  conteudo        String?   @db.Text
  ativo           Boolean   @default(true)
  destaque        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([numero])
  @@index([ativo])
  @@index([destaque])
}

model AtrativoTuristico {
  id              String    @id @default(cuid())
  nome            String
  descricao       String?   @db.Text
  imagem          String?
  categoria       String    // "parque", "cassino", "lago", "florestal"
  ordem           Int       @default(0)
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([ativo])
  @@index([ordem])
}

model FonteMuneral {
  id              String    @id @default(cuid())
  nome            String
  descricao       String?   @db.Text
  propriedades    String?   @db.Text
  ordem           Int       @default(0)
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([ativo])
  @@index([ordem])
}

model DocumentoTransparencia {
  id              String    @id @default(cuid())
  titulo          String
  descricao       String?   @db.Text
  categoria       String    // "orcamento", "licitacoes", "gestao", "receitas"
  url             String?
  arquivo         String?   // URL do arquivo
  dataPublicacao  DateTime?
  ordem           Int       @default(0)
  ativo           Boolean   @default(true)
  destaque        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoria])
  @@index([ativo])
  @@index([ordem])
}

// ==============================================
// FASE 2 - FUNCIONALIDADES INOVADORAS
// ==============================================

// --- Chatbot de Transparência ---
model ChatbotConversation {
  id         String            @id @default(cuid())
  sessionId  String
  messages   ChatbotMessage[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([sessionId])
}

model ChatbotMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String              // "user" | "assistant"
  content        String              @db.Text
  metadata       Json?               // dados de contexto como docs encontrados
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

// --- Orçamento Participativo Gamificado ---
enum PropostaStatus {
  RASCUNHO
  ABERTA_VOTACAO
  APROVADA
  EM_EXECUCAO
  CONCLUIDA
  REJEITADA
}

model PropostaOrcamentaria {
  id             String          @id @default(cuid())
  titulo         String
  descricao      String          @db.Text
  categoria      String          // "educacao", "saude", "infraestrutura", "cultura", "esporte", "meio_ambiente"
  valorEstimado  Decimal?        @db.Decimal(15, 2)
  bairro         String?
  autorNome      String
  autorEmail     String
  status         PropostaStatus  @default(RASCUNHO)
  votos          VotoProposta[]
  totalVotos     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([categoria])
  @@index([totalVotos])
}

model VotoProposta {
  id         String              @id @default(cuid())
  propostaId String
  proposta   PropostaOrcamentaria @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  cidadaoId  String
  cidadao    CidadaoParticipante @relation(fields: [cidadaoId], references: [id])
  createdAt  DateTime            @default(now())

  @@unique([propostaId, cidadaoId])
  @@index([propostaId])
  @@index([cidadaoId])
}

model CidadaoParticipante {
  id         String          @id @default(cuid())
  nome       String
  email      String          @unique
  cpfHash    String?         @unique  // hash do CPF para verificação sem armazenar dado sensível
  pontos     Int             @default(0)
  nivel      String          @default("Cidadão Iniciante")
  badges     BadgeCidadao[]
  votos      VotoProposta[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([email])
  @@index([pontos])
}

model BadgeCidadao {
  id          String              @id @default(cuid())
  cidadaoId   String
  cidadao     CidadaoParticipante @relation(fields: [cidadaoId], references: [id], onDelete: Cascade)
  tipo        String              // "primeiro_voto", "5_votos", "proposta_aprovada", etc.
  titulo      String
  descricao   String?
  icone       String?
  conqueredAt DateTime            @default(now())

  @@unique([cidadaoId, tipo])
  @@index([cidadaoId])
}

// --- Hub Integrado de Secretarias ---
enum ProtocoloStatus {
  ABERTO
  EM_ANALISE
  EM_TRAMITACAO
  AGUARDANDO_RESPOSTA
  RESPONDIDO
  FINALIZADO
  ARQUIVADO
}

model Protocolo {
  id               String            @id @default(cuid())
  numero           String            @unique
  titulo           String
  descricao        String            @db.Text
  tipo             String            // "reclamacao", "solicitacao", "sugestao", "denuncia"
  prioridade       String            @default("normal")  // "baixa", "normal", "alta", "urgente"
  status           ProtocoloStatus   @default(ABERTO)
  secretariaAtualId String?
  solicitanteNome  String
  solicitanteEmail String
  solicitanteTel   String?
  tramitacoes      Tramitacao[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([numero])
  @@index([status])
  @@index([secretariaAtualId])
}

model Tramitacao {
  id              String          @id @default(cuid())
  protocoloId     String
  protocolo       Protocolo       @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  deSecretariaId  String?
  paraSecretariaId String?
  deSecretaria    String?
  paraSecretaria  String?
  observacao      String?         @db.Text
  responsavel     String?
  dataEntrada     DateTime        @default(now())
  dataSaida       DateTime?

  @@index([protocoloId])
}

// --- Dashboard Smart City ---
model IndicadorSmartCity {
  id          String    @id @default(cuid())
  categoria   String    // "clima", "saude", "educacao", "infraestrutura", "seguranca"
  nome        String
  valor       String
  unidade     String?
  icone       String?
  fonte       String?
  atualizadoEm DateTime @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoria])
}

model AlertaMunicipal {
  id          String    @id @default(cuid())
  tipo        String    // "clima", "saude", "seguranca", "infraestrutura"
  titulo      String
  descricao   String    @db.Text
  severidade  String    @default("info")  // "info", "warning", "danger"
  ativo       Boolean   @default(true)
  expiraEm    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tipo])
  @@index([ativo])
}


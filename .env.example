# ============================================
# Plataforma Municipal - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="gere-uma-chave-segura-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# App URL (para compartilhamento em redes sociais)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Azure (Produção)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME=""

# OpenAI API (Chatbot de Transparência)
OPENAI_API_KEY=""

# Smart City APIs
OPENWEATHER_API_KEY=""
IBGE_API_URL="https://servicodados.ibge.gov.br/api/v3"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Logs
LOG_LEVEL="info"
NODE_ENV="development"
